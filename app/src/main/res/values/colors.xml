<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette. On Android 12+ values-v31 replaces the neutral and accent colors
     with the system's Material You colors (taken from the wallpaper / theme). -->
<resources>
    <color name="surface">#F7F8FB</color>
    <color name="card">#ECEFF5</color>
    <color name="tile">#FFFFFF</color>
    <color name="border">#D5D8E0</color>

    <color name="accent">#2F5BD3</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="accent_soft">#DCE4FA</color>

    <color name="text_primary">#1B1C1F</color>
    <color name="text_secondary">#5D6068</color>
    <color name="text_muted">#8E9199</color>

    <color name="neutral_soft">#E1E3E8</color>
    <color name="success">#1E7D46</color>
    <color name="success_soft">#D6F0DF</color>
    <color name="warning">#8A5A00</color>
    <color name="warning_soft">#FBE9C7</color>
    <color name="danger">#B3261E</color>
    <color name="danger_soft">#F9DEDC</color>

    <!-- Start / Stop button: solid, white text in both themes. -->
    <color name="start_button">#1E7D46</color>
    <color name="stop_button">#B3261E</color>
</resources>
