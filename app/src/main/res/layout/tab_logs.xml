<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Level filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/filterAll"
            style="@style/Pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/logs_all"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/filterWarning"
            style="@style/Pill"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/logs_warning"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/filterError"
            style="@style/Pill"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/logs_error"
            android:textSize="13sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Clear all logs (asks for confirmation) -->
        <TextView
            android:id="@+id/clearLogs"
            style="@style/Pill"
            android:backgroundTint="@color/danger_soft"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/logs_clear"
            android:textColor="@color/danger"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/logsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/border"
            android:dividerHeight="1px"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/logsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:text="@string/logs_empty"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
